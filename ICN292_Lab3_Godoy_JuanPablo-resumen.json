              "name": "total_solicitudes",
              "value": "={{ \n  ($json.APROBACION?.count_id_solicitud ?? 0) +\n  ($json.REVISION?.count_id_solicitud ?? 0) +\n  ($json.RECHAZO?.count_id_solicitud ?? 0) +\n  ($json.DATOS_INVALIDOS?.count_id_solicitud ?? 0)\n}}",
              "type": "number"
            },
            {
              "id": "605c2f07-cac2-4be4-9ecb-69eb15deb37e",
              "name": "monto_total_uf",
              "value": "={{\n  Number((\n    ($json.APROBACION?.sum_monto_uf ?? 0) +\n    ($json.REVISION?.sum_monto_uf ?? 0) +\n    ($json.RECHAZO?.sum_monto_uf ?? 0) +\n    ($json.DATOS_INVALIDOS?.sum_monto_uf ?? 0)\n  ).toFixed(2))\n}}",
              "type": "number"
            },
            {
              "id": "368ef037-6092-4c5c-b918-5e14a6df7918",
              "name": "tasa_aprobacion",
              "value": "={{\n  Number((\n    (($json.APROBACION?.count_id_solicitud ?? 0) /\n    (\n      ($json.APROBACION?.count_id_solicitud ?? 0) +\n      ($json.REVISION?.count_id_solicitud ?? 0) +\n      ($json.RECHAZO?.count_id_solicitud ?? 0) +\n      ($json.DATOS_INVALIDOS?.count_id_solicitud ?? 0)\n    )) * 100\n  ).toFixed(2))\n}}",
              "type": "number"
            }
          ]
        },
